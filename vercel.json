{
  "crons": [
    { "path": "/api/rss/0", "schedule": "0 0 * * *" },
    { "path": "/api/rss/1", "schedule": "2 0 * * *" },
    { "path": "/api/rss/2", "schedule": "4 0 * * *" }
  ],
  "functions": {
    "app/api/rss/[batch]/route.ts": {
      "runtime": "vercel/node@22.x",
      "maxDuration": 30
    },
    "app/api/rss/trigger/route.ts": {
      "runtime": "vercel/node@22.x",
      "maxDuration": 300
    }
  },
  "env": { "CRON_SECRET": "@cron_secret" }
}
